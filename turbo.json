{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/api/medusa-config.ts"
      ],
      "env": [
        "NODE_ENV",
        "MERCUR_BACKEND_URL",
        "VITE_MERCUR_BACKEND_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "PAYLOAD_DATABASE_URL",
        "OPENSEARCH_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".medusa/**",
        "dist/**",
        "build/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:unit": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
