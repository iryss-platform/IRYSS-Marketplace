FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
RUN apk add --no-cache python3 make g++ curl

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/api/package.json packages/api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/api-client/package.json packages/api-client/
COPY packages/test-utils/package.json packages/test-utils/
COPY apps/admin/package.json apps/admin/
COPY apps/vendor/package.json apps/vendor/
COPY apps/b2c-storefront/package.json apps/b2c-storefront/
COPY apps/b2b-storefront/package.json apps/b2b-storefront/
COPY apps/reseller-portal/package.json apps/reseller-portal/
COPY apps/payload-cms/package.json apps/payload-cms/
COPY apps/content-platform/package.json apps/content-platform/
COPY apps/shopify-connector/package.json apps/shopify-connector/

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 9000

WORKDIR /app/packages/api
CMD ["npx", "medusa", "develop", "--no-browser"]
