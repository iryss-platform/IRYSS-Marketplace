FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
RUN apk add --no-cache python3 make g++ curl

WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/api/package.json packages/api/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/api-client/package.json packages/api-client/
COPY packages/test-utils/package.json packages/test-utils/
COPY apps/admin/package.json apps/admin/
COPY apps/vendor/package.json apps/vendor/
COPY apps/b2c-storefront/package.json apps/b2c-storefront/
COPY apps/b2b-storefront/package.json apps/b2b-storefront/
COPY apps/reseller-portal/package.json apps/reseller-portal/
COPY apps/payload-cms/package.json apps/payload-cms/
COPY apps/content-platform/package.json apps/content-platform/
COPY apps/shopify-connector/package.json apps/shopify-connector/

# Install ALL deps (including dev) — needed to build admin/vendor panels
ENV NODE_ENV=development
RUN pnpm install --frozen-lockfile

# Copy all source
COPY . .

# Create medusa-config.js bridge for ts-node
WORKDIR /app/packages/api
RUN echo "require('ts-node').register({transpileOnly:true,compilerOptions:{module:'commonjs',moduleResolution:'node'}});module.exports=require('./medusa-config.ts');" > medusa-config.js

# Build admin panel
ARG MERCUR_BACKEND_URL=http://localhost:9000
ARG VITE_MERCUR_BACKEND_URL
ENV MERCUR_BACKEND_URL=${MERCUR_BACKEND_URL}
ENV VITE_MERCUR_BACKEND_URL=${VITE_MERCUR_BACKEND_URL:-$MERCUR_BACKEND_URL}
RUN cd /app/apps/admin && npx vite build
RUN cd /app/apps/vendor && npx vite build

# Build medusa (compiles API + bundles dashboards into .medusa/server/)
ENV NODE_ENV=production
RUN pnpm build

# Production runtime
FROM node:20-alpine
RUN apk add --no-cache curl
WORKDIR /app/packages/api

# Copy the built medusa artifact
COPY --from=builder /app/packages/api/.medusa ./.medusa
COPY --from=builder /app/packages/api/package.json ./package.json
COPY --from=builder /app/packages/api/medusa-config.js ./medusa-config.js
COPY --from=builder /app/packages/api/medusa-config.ts ./medusa-config.ts

# Install production deps in the artifact
RUN cd .medusa/server && npm install --production 2>/dev/null; exit 0

ENV HOST=0.0.0.0
ENV NODE_ENV=production
EXPOSE 9000
CMD ["npm", "run", "start"]
