FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/api/package.json packages/api/
COPY packages/contracts/package.json packages/contracts/
COPY apps/admin/package.json apps/admin/
COPY apps/vendor/package.json apps/vendor/
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY . .

RUN pnpm --filter @iryss/admin build
RUN pnpm --filter @iryss/vendor build
RUN cd packages/api && pnpm build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/packages/api/.medusa ./packages/api/.medusa
COPY --from=builder /app/packages/api/package.json ./packages/api/
COPY --from=builder /app/packages/api/medusa-config.ts ./packages/api/
WORKDIR /app/packages/api

RUN cd .medusa/server && npm install --production

EXPOSE 9000
CMD ["npm", "run", "start"]
