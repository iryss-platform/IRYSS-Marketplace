{
  "compilerOptions": {
    "lib": ["es2021"],
    "target": "es2021",
    "outDir": "./dist",
    "esModuleInterop": true,
    "declaration": true,
    "module": "preserve",
    "moduleResolution": "Bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["src", "medusa-config.ts", "instrumentation.ts"],
  "exclude": ["dist", ".medusa", "node_modules", "integration-tests"]
}
